# Зависимости
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json должен быть в git для CI/CD
# yarn.lock тоже, если используется yarn

# Скомпилированные файлы
dist/
*.js
*.js.map
*.d.ts
*.d.ts.map

# Исключения для корневых конфигурационных файлов
!*.config.js
!eslint.config.js


# Скомпилированные скрипты (используем только TS-исходники)
scripts/*.js
scripts/*.js.map
scripts/*.d.ts
scripts/*.d.ts.map
# ...но flat-конфиг ESLint — исходник, а не артефакт: без этой строки
# lint:root-scripts зелёный локально и падает в CI, где файла нет.
!scripts/eslint.config.js

# Временные файлы
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Переменные окружения (важно для безопасности!)
.env
.env.local
.env.*.local

# Тестирование
coverage/
.nyc_output/

# Архивы бандла
*.mcpb
*.zip

# Отладка
debug/

# Логи
logs/
*.log.gz

# TypeScript incremental compilation cache
*.tsbuildinfo

# Отчёты инструментов качества кода
knip-report.json
dependency-graph.svg
dependency-graph.html
jscpd-report/
*.mcpb
.mcpb-build/

# Динамически генерируемые файлы (build hash обновляется при каждой сборке)
packages/servers/*/manifest.json

# Turborepo
.turbo/
