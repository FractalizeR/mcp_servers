// Типизация тестов. scripts/** сюда НЕ входит: скрипты импортируют общий
// проводной харнесс из ../scripts/mcp-wire-harness/, который лежит выше
// rootDir этого конфига, и tsc валится с TS6059. Их покрывает
// tsconfig.scripts.json с rootDir "..".
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // DOM нужен только тестам: единственный потребитель — прогон HTML-бандла
    // MCP Apps в jsdom (tests/resources/issue-description-editor.widget.test.ts).
    // Конфиг включает и src/** (нужен для резолва), поэтому здесь DOM-глобали
    // видны и коду сервера — но барьер держит основной `npm run typecheck`:
    // он идёт по tsconfig.json с lib ES2022 и на `document` в src/** падает
    // TS2584. Проверено мутацией, а не рассуждением.
    "lib": ["ES2022", "DOM"],
    "rootDir": ".",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
