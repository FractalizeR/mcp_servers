{
  "name": "@fractalizer/mcp-cli",
  "version": "2.5.1",
  "description": "Generic CLI for MCP server connection management",
  "keywords": [
    "mcp",
    "cli",
    "claude",
    "connector",
    "command-line"
  ],
  "homepage": "https://github.com/FractalizeR/mcp_servers/tree/main/packages/framework/cli#readme",
  "bugs": {
    "url": "https://github.com/FractalizeR/mcp_servers/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FractalizeR/mcp_servers.git",
    "directory": "packages/framework/cli"
  },
  "license": "PolyForm-Shield-1.0.0",
  "author": "Fractalizer",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./connectors": {
      "types": "./dist/connectors/index.d.ts",
      "default": "./dist/connectors/index.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "default": "./dist/commands/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./*": "./dist/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && tsc-alias",
    "clean": "rimraf dist",
    "cpd": "jscpd src",
    "cpd:quiet": "jscpd src --silent",
    "cpd:report": "jscpd src --reporters html,console",
    "depcruise": "cd ../../.. && depcruise packages/framework/cli/src -c .dependency-cruiser.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint src --ext .ts --max-warnings=17",
    "lint:fix": "eslint src --ext .ts --fix",
    "lint:quiet": "npm run lint -- --quiet",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:quiet": "vitest run --reporter=dot --silent",
    "test:verbose": "vitest run --reporter=verbose",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "validate": "npm run lint && npm run typecheck && npm run typecheck:tests && npm run test && npm run cpd && npm run depcruise && npm run validate:docs",
    "validate:docs": "tsx ../../../scripts/validate-docs-size.ts",
    "validate:quiet": "npm run lint:quiet && npm run typecheck && npm run typecheck:tests && npm run test:quiet && npm run cpd:quiet && npm run depcruise && npm run validate:docs"
  },
  "dependencies": {
    "@fractalizer/mcp-infrastructure": "^2.5.1",
    "@iarna/toml": "^2.2.5",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer": "^13.3.2",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
