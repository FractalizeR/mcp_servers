{
  "name": "@fractalizer/mcp-dev-client",
  "version": "2.0.0",
  "private": true,
  "description": "Dev-only MCP client: open a real stdio session against a locally built server bundle, list/call tools, run batches — without registering the agent as an MCP client",
  "keywords": [
    "mcp",
    "dev",
    "client",
    "internal"
  ],
  "homepage": "https://github.com/FractalizeR/mcp_servers/tree/main/packages/framework/dev-client#readme",
  "bugs": {
    "url": "https://github.com/FractalizeR/mcp_servers/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FractalizeR/mcp_servers.git",
    "directory": "packages/framework/dev-client"
  },
  "license": "PolyForm-Shield-1.0.0",
  "author": "Fractalizer",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-dev": "dist/cli/bin/mcp-dev.js"
  },
  "scripts": {
    "build": "tsc -b && tsc-alias",
    "clean": "rimraf dist",
    "cpd": "jscpd src",
    "cpd:quiet": "jscpd src --silent",
    "cpd:report": "jscpd src --reporters html,console",
    "depcruise": "cd ../../.. && depcruise packages/framework/dev-client/src -c .dependency-cruiser.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "lint:quiet": "eslint src --ext .ts --quiet",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:quiet": "vitest run --reporter=dot --silent",
    "test:verbose": "vitest run --reporter=verbose",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run cpd && npm run depcruise && npm run validate:docs",
    "validate:docs": "tsx ../../../scripts/validate-docs-size.ts",
    "validate:quiet": "npm run lint:quiet && npm run typecheck && npm run test:quiet && npm run cpd:quiet && npm run depcruise && npm run validate:docs"
  },
  "dependencies": {
    "@fractalizer/mcp-cli": "^2.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "commander": "^14.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
