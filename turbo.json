{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "build:bundle": {
      "dependsOn": ["build"],
      "outputs": ["dist/**/*.bundle.*", "dist/**/*.cjs"],
      "cache": true
    },
    "build:mcpb": {
      "dependsOn": ["build"],
      "outputs": ["*.mcpb", ".mcpb-build/**"],
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "test:quiet": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true
    },
    "test:verbose": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true
    },
    "test:watch": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "test:smoke": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:smoke:server": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:raw-wire": {
      "dependsOn": ["build"],
      "inputs": ["dist/**/*.bundle.cjs", "scripts/raw-wire-test.ts"],
      "cache": false
    },
    "lint": {
      "cache": true,
      "inputs": ["src/**/*.ts", "scripts/**/*.ts", "eslint.config.js", "package.json"]
    },
    "lint:fix": {
      "cache": false
    },
    "lint:quiet": {
      "cache": true,
      "inputs": ["src/**/*.ts", "scripts/**/*.ts", "eslint.config.js", "package.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["src/**/*.ts", "tests/**/*.ts", "tsconfig*.json"],
      "outputs": []
    },
    "typecheck:scripts": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["src/**/*.ts", "scripts/**/*.ts", "tsconfig*.json"],
      "outputs": []
    },
    "typecheck:tests": {
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["src/**/*.ts", "tests/**/*.ts", "tsconfig*.json"],
      "outputs": []
    },
    "coverage:matrix": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "tests/live-runs/**",
        "scripts/build-coverage-matrix.ts"
      ],
      "outputs": ["tests/COVERAGE_MATRIX.md"]
    },
    "coverage:check": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "tests/live-runs/**",
        "tests/COVERAGE_MATRIX.md",
        "scripts/build-coverage-matrix.ts"
      ],
      "outputs": []
    },
    "cpd": {
      "cache": true,
      "inputs": ["src/**/*.ts"],
      "outputs": []
    },
    "cpd:quiet": {
      "cache": true,
      "inputs": ["src/**/*.ts"],
      "outputs": []
    },
    "cpd:report": {
      "cache": true,
      "inputs": ["src/**/*.ts"],
      "outputs": ["jscpd-report/**"]
    },
    "depcruise": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "tsconfig*.json"],
      "outputs": []
    },
    "validate:docs": {
      "cache": true,
      "inputs": ["**/*.md", "!node_modules/**", "scripts/validate-docs-size.ts"],
      "outputs": []
    },
    "validate:tools": {
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["src/**/*.ts", "scripts/validate-tool-registration.ts"]
    },
    "knip": {
      "cache": true,
      "inputs": ["packages/**/*.ts", "knip.json", "package.json", "packages/**/package.json"],
      "outputs": ["knip-report.json"]
    }
  },
  "globalDependencies": [
    ".npmrc",
    "package-lock.json",
    ".jscpd.json",
    ".dependency-cruiser.cjs",
    "eslint.shared.config.js",
    "tsconfig.base.json",
    "packages/framework/tsconfig.base.json",
    "packages/servers/tsconfig.base.json"
  ],
  "globalEnv": ["NODE_ENV"]
}
