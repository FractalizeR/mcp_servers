{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Root Scripts Configuration",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/node_modules/**", "**/dist/**"]
}
